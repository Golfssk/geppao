{
  "name": "geppao-mvp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "npm run verify:migrations && npm run test:stays && npm run test:host && npm run test:admin && npm run test:intake && npm run test:search && npm run test:destinations && npm run test:health && npm run typecheck && npm run build",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "write:migration-manifest": "node scripts/verify-migrations.mjs --write",
    "test:health": "node --experimental-strip-types --test tests/health-*.test.mjs",
    "test:stays": "node --experimental-strip-types --test tests/stays-*.test.mjs",
    "test:host": "node --experimental-strip-types --test tests/host-*.test.mjs",
    "test:admin": "node --experimental-strip-types --test tests/admin-*.test.mjs",
    "test:intake": "node --experimental-strip-types --test tests/intake-*.test.mjs",
    "test:search": "node --experimental-strip-types --test tests/search-*.test.mjs",
    "test:destinations": "node --experimental-strip-types --test tests/destinations-*.test.mjs",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "7.7.1",
    "@electric-sql/pglite": "0.3.14",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.28",
    "supabase": "2.118.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
